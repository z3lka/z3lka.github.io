---
layout: base.njk
---

<article class="page-article project-article section-reveal">
  <a class="back-link" href="/#projects">← Selected work</a>
  <header class="article-header project-header">
    <span class="section-label">{{ category }} · {{ period }}</span>
    <h1>{{ title }}</h1>
    <p class="project-deck">{{ description }}</p>
    <ul class="project-stack" aria-label="Tools used">
      {% for tool in stack %}<li>{{ tool }}</li>{% endfor %}
    </ul>
    <nav class="project-links" aria-label="{{ title }} links">
      {% for link in links %}<a href="{{ link.url }}">{{ link.label }} <span aria-hidden="true">↗</span></a>{% endfor %}
    </nav>
  </header>

  <figure class="project-hero project-hero--{{ image.tone }}">
    <img src="{{ image.src | url }}" alt="{{ image.alt }}" width="{{ image.width }}" height="{{ image.height }}" decoding="async">
    <figcaption>{{ imageCaption }}{% if imageCreditUrl %} <a href="{{ imageCreditUrl }}">Image source</a>.{% endif %}</figcaption>
  </figure>

  <dl class="project-facts">
    {% for fact in facts %}
      <div><dt>{{ fact.label }}</dt><dd>{{ fact.value }}</dd></div>
    {% endfor %}
  </dl>

  <div class="article-body">
    {{ content | safe }}
  </div>

  <div class="article-footer">
    <p><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
  </div>
</article>
